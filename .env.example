# Copy to .env for local runs. Never commit the real .env.

# From @BotFather in Telegram, after /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any long random string you invent. It goes in the webhook URL path, so
# strangers cannot guess the endpoint.
WEBHOOK_SECRET=change-me-to-something-long-and-random

# A SECOND, different random string, used as ?key= on /cleanup. Keep it separate
# from WEBHOOK_SECRET: query strings show up in the cron provider's dashboard and
# in Render's request logs, and anyone holding the webhook path can post forged
# updates -- including one claiming to be from an admin, which skips all quotas.
CLEANUP_KEY=change-me-to-a-different-long-random-string

# Optional hardening. If you set this, pass the same value as secret_token when
# you call setWebhook, and the bot will reject any POST without the matching
# X-Telegram-Bot-Api-Secret-Token header. Leave empty to skip the check.
WEBHOOK_HEADER_SECRET=

# Comma-separated Telegram numeric user IDs that bypass all rate limits.
# Get yours by messaging @userinfobot.
ADMIN_USER_IDS=123456789

# Gemini model. gemini-2.0-flash was shut down 2026-06-01; this is the current
# audio-capable replacement and it is on the free tier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Minimum seconds between Gemini calls, process-wide. The free tier limits
# requests per minute as well as per day; 4s is roughly 15/min.
GEMINI_MIN_INTERVAL_SECONDS=4.0

# How many times to retry a Gemini call that fails with a rate limit or a 5xx.
GEMINI_MAX_ATTEMPTS=3

# Most messages one /summary or /export will pull. Keeps memory and Firestore
# reads bounded on the free tiers.
MAX_MESSAGES_PER_REQUEST=2000

# Timezone offset used to decide when "today" starts. Cambodia is UTC+7.
LOCAL_UTC_OFFSET_HOURS=7

# Path to the Firebase service account JSON key.
# On Render this is the Secret File mount: /etc/secrets/gcp-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Local only; Render sets PORT itself.
PORT=10000

# Note: there is deliberately no GCS_BUCKET. This bot stores no audio --
# Cloud Storage for Firebase requires the paid Blaze plan, and voice notes
# already live on Telegram's servers, reachable by file_id.
